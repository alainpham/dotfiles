#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo script directory : $SCRIPT_DIR

# Detect the OS from /etc/os-release's ID field and map it to a modules dir.
source /etc/os-release
case "$ID" in
    *tumbleweed*) OS="tumbleweed" ;;
    opensuse*) OS="tumbleweed" ;;
    ubuntu)       OS="ubuntu" ;;
    cachyos)      OS="cachy" ;;
    *) echo "Unsupported OS ID: '$ID'" >&2; exit 1 ;;
esac
echo "detected OS : $OS"

select file in "$SCRIPT_DIR/vars/"*.sh; do
    if [[ -n "$file" ]]; then
        echo "You selected: $file"
        export TARGETVARS=$file
        cat $TARGETVARS
        break
    else
        echo "Invalid selection. Please try again."
    fi
done

# select file in "$SCRIPT_DIR/hw/"*.sh; do
#     if [[ -n $file ]]; then
#         echo "You selected: $file"
#         export TARGETHW="$file"
#         cat $TARGETHW
#         break
#     else
#         echo "No hardware selected. Please try again."
#     fi
# done


#####################
echo copy vars.sh file
cp $TARGETVARS /etc/profile.d/vars.sh
chmod 644 /etc/profile.d/vars.sh
source /etc/profile.d/vars.sh

echo copy sources.sh file
cp /home/$TARGET_USERNAME/dotfiles/osinstall/sources.sh /etc/profile.d/sources.sh
chmod 644 /etc/profile.d/sources.sh
source /etc/profile.d/sources.sh

echo "running common.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/$OS/modules/common.sh"
echo "running common-generic.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/generic/common-generic.sh"

# current_hostname="$(hostnamectl --static status 2>/dev/null)"
# if [[ -z "$current_hostname" && -n "${HOSTNAME:-}" ]]; then
#     echo "hostname is unset; setting hostname to $HOSTNAME"
#     hostnamectl hostname "$HOSTNAME"
# fi

if [ "$ENABLE_DEV" == "true" ]; then
echo "running dev.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/$OS/modules/dev.sh"
fi

if [ "$ENABLE_DEVAI" == "true" ]; then
echo "running devai.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/$OS/modules/devai.sh"
fi

if [ "$ENABLE_CONTAINERS" == "true" ]; then
echo "running containers.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/$OS/modules/containers.sh"
fi

if [ "$ENABLE_DWM" == "true" ]; then
echo "running dwm.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/$OS/modules/dwm.sh"
fi
if [ "$ENABLE_GUI" == "true" ]; then
echo "running gui.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/$OS/modules/gui.sh"
fi
if [ "$ENABLE_WORKSTATION" == "true" ]; then
echo "running workstation.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/$OS/modules/workstation.sh"
fi
if [ "$ENABLE_VIRTUALIZATION" == "true" ]; then
echo "running virtualization.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/$OS/modules/virtualization.sh"
fi
if [ "$ENABLE_GAMING" == "true" ]; then
echo "running gaming.sh"
bash "/home/$TARGET_USERNAME/dotfiles/osinstall/$OS/modules/gaming.sh"
fi
