#!/bin/bash

# ── Configuration ─────────────────────────────────────────────────────────────
NAMESPACE="traefik"
SECRET_NAME="traefik-tls"
CERT_FILE="$HOME/apps/tls/cfg/live/$K3S_WILDCARD_DOMAIN/fullchain.pem"   # path to TLS certificate
KEY_FILE="$HOME/apps/tls/cfg/live/$K3S_WILDCARD_DOMAIN/privkey.pem"  # path to TLS private key

# ── Create namespace ──────────────────────────────────────────────────────────
kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -

# ── TLS Secret ────────────────────────────────────────────────────────────────
kubectl create secret tls "$SECRET_NAME" \
  --cert="$CERT_FILE" \
  --key="$KEY_FILE" \
  --namespace="$NAMESPACE" \
  --dry-run=client -o yaml | kubectl apply -f -

# ── Helm install ──────────────────────────────────────────────────────────────
helm repo add traefik https://traefik.github.io/charts
helm repo update

sed \
  -e "s/__SECRET_NAME__/${SECRET_NAME}/g" \
  -e "s/__K3S_WILDCARD_DOMAIN__/${K3S_WILDCARD_DOMAIN}/g" \
  <<'EOF' | helm upgrade --install traefik traefik/traefik \
  --namespace "$NAMESPACE" \
  --values -
deployment:
  kind: DaemonSet

service:
  type: ClusterIP

ports:
  web:
    hostPort: 80
    expose:
      default: true
  websecure:
    hostPort: 443
    expose:
      default: true

tlsStore:
  default:
    defaultCertificate:
      secretName: __SECRET_NAME__

ingressRoute:
  dashboard:
    enabled: true
    matchRule: 'Host(`traefik.__K3S_WILDCARD_DOMAIN__`)'
    entryPoints: ["websecure"]
    middlewares:
      - name: traefik-dashboard-auth

extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: traefik-dashboard-auth-secret
    type: kubernetes.io/basic-auth
    stringData:
      username: admin
      password: password

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: traefik-dashboard-auth
    spec:
      basicAuth:
        secret: traefik-dashboard-auth-secret

EOF
