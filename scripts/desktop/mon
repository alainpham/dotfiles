#!/bin/bash
# mon - apply an X11 monitor layout
#
# Screens are identified by the sha256sum of their EDID (computed by the
# companion `monid` script, which must be in PATH), so a saved layout is
# stable no matter which xrandr output a given physical screen lands on.
#
# ~/.sclayout format - one connected screen per line, in left-to-right order:
#
#     <sha256sum-of-edid> <human_name_with_underscores>
#
# The human name is purely for readability; matching is done on the sha256sum.

MONID="monid"
LAYOUT_FILE="$HOME/.sclayout"
LOG="$HOME/.mon.log"

command="$1"

log(){ echo "$(date) $*" >> "$LOG"; }

if [ "$command" == "help" ]; then
    echo "Usage: $0 [command]"
    echo "Commands:"
    echo "  la      - Show only laptop screen"
    echo "  hd      - Show HDMI only"
    echo "  cp      - mirror all screens"
    echo "  hl      - Show HDMI left of laptop screen"
    echo "  hr      - Show HDMI right of laptop screen"
    echo "  <empty> - Apply the saved layout from ~/.sclayout"
    echo
    echo "~/.sclayout lines are:  <sha256sum-of-edid> <human_name>"
    echo "Screens are listed left-to-right; run 'monid' to discover the"
    echo "sha256sums of the currently connected screens."
    exit 0
fi

if ! command -v "$MONID" >/dev/null 2>&1; then
    echo "Cannot find 'monid' in PATH." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Discover currently connected screens via monid.
#   CONN_OUTPUT[sha] = xrandr output id
#   CONN_NAME[sha]   = human readable name
# ---------------------------------------------------------------------------
declare -A CONN_OUTPUT
declare -A CONN_NAME
laptop_sha=""
laptop_name=""
hdmi_sha=""

while read -r sha name output; do
    [ -z "$sha" ] && continue
    CONN_OUTPUT["$sha"]="$output"
    CONN_NAME["$sha"]="$name"
    # The internal laptop panel is an eDP (or older LVDS / mobile DSI) output.
    if [[ "$output" =~ ^(eDP|LVDS|DSI) ]]; then
        laptop_sha="$sha"
        laptop_name="$name"
    fi
    # First HDMI output found.
    if [[ "$output" =~ HDMI ]] && [ -z "$hdmi_sha" ]; then
        hdmi_sha="$sha"
    fi
done < <("$MONID")

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Print " --output X --off" for every connected screen NOT in the given list
# of outputs to keep on.
others_off_args(){
    local keep=("$@") sha out k listed
    for sha in "${!CONN_OUTPUT[@]}"; do
        out="${CONN_OUTPUT[$sha]}"
        listed=0
        for k in "${keep[@]}"; do
            [ "$k" == "$out" ] && { listed=1; break; }
        done
        [ "$listed" -eq 0 ] && printf ' --output %s --off' "$out"
    done
}

refresh_wallpaper(){ [ -x "$HOME/.fehbg" ] && "$HOME/.fehbg"; return 0; }

# Show a single screen, turning off all others.
single_screen(){   # $1 = sha, $2 = label
    local out="" off
    [ -n "$1" ] && out="${CONN_OUTPUT[$1]}"
    if [ -z "$out" ]; then
        echo "$2 screen not connected."
        return 1
    fi
    log "$2 screen only ($out)"
    echo "$2 screen only: $out"
    off=$(others_off_args "$out")
    xrandr --output "$out" --auto --primary --pos 0x0 $off
    refresh_wallpaper
}

# HDMI to the left or right of the laptop screen.
hdmi_beside_laptop(){   # $1 = left|right
    local lo="" ho="" rel off
    [ -n "$laptop_sha" ] && lo="${CONN_OUTPUT[$laptop_sha]}"
    [ -n "$hdmi_sha" ]   && ho="${CONN_OUTPUT[$hdmi_sha]}"
    if [ -z "$lo" ]; then echo "Laptop screen not connected."; return 1; fi
    if [ -z "$ho" ]; then echo "HDMI screen not connected."; return 1; fi
    if [ "$1" == "right" ]; then rel="--right-of"; else rel="--left-of"; fi
    log "HDMI ($ho) $1 of laptop ($lo)"
    echo "HDMI $1 of laptop: laptop=$lo hdmi=$ho"
    off=$(others_off_args "$lo" "$ho")
    xrandr --output "$lo" --auto --primary --pos 0x0 \
           --output "$ho" --auto "$rel" "$lo" $off
    refresh_wallpaper
}

# Mirror every connected screen at the best common mode reported by the
# `bestmode` command, which prints "<WxH> <frequency>" or "0" if no single
# mode is supported by every connected screen.
mirror_all(){
    local mode res rate args=() first="" sha out
    mode=$(bestmode 2>/dev/null)

    if [ -n "$mode" ] && [ "$mode" != "0" ]; then
        res=$(echo "$mode" | awk '{print $1}')
        rate=$(echo "$mode" | awk '{print $2}')
    else
        echo "bestmode found no common mode; falling back to each screen's auto mode."
        res=""
        rate=""
    fi

    for sha in "${!CONN_OUTPUT[@]}"; do
        out="${CONN_OUTPUT[$sha]}"
        if [ -z "$first" ]; then
            first="$out"
            if [ -n "$res" ]; then
                args+=(--output "$out" --mode "$res" --rate "$rate" --pos 0x0 --rotate normal --primary)
            else
                args+=(--output "$out" --auto --pos 0x0 --primary)
            fi
        else
            if [ -n "$res" ]; then
                args+=(--output "$out" --mode "$res" --rate "$rate" --same-as "$first" --rotate normal)
            else
                args+=(--output "$out" --auto --same-as "$first")
            fi
        fi
    done

    log "mirror all screens, mode=${res:-auto} rate=${rate:-auto}"
    echo "Mirroring all screens at mode ${res:-auto} rate ${rate:-auto}"
    xrandr "${args[@]}"
    refresh_wallpaper
}

# ---------------------------------------------------------------------------
# Saved-layout (~/.sclayout) handling
# ---------------------------------------------------------------------------

# Valid layout: file exists, non-empty, every line is a 64-hex sha + a name.
valid_layout(){
    [ -s "$LAYOUT_FILE" ] || return 1
    local sha name
    while read -r sha name; do
        [[ "$sha" =~ ^[0-9a-fA-F]{64}$ ]] || return 1
        [ -n "$name" ] || return 1
    done < "$LAYOUT_FILE"
    return 0
}

# Create a default layout containing only the detected laptop screen.
create_default(){
    if [ -n "$laptop_sha" ]; then
        local n="$laptop_name"
        [ "$n" == "UNKNOWN" ] && n="laptop"
        echo "$laptop_sha $n" > "$LAYOUT_FILE"
        log "created default ~/.sclayout with laptop screen $laptop_sha ($n)"
        echo "Created default ~/.sclayout: $laptop_sha $n"
    elif [ "${#CONN_OUTPUT[@]}" -gt 0 ]; then
        local sha
        for sha in "${!CONN_OUTPUT[@]}"; do
            echo "$sha ${CONN_NAME[$sha]}" > "$LAYOUT_FILE"
            log "created default ~/.sclayout with screen $sha (${CONN_NAME[$sha]})"
            echo "Created default ~/.sclayout: $sha ${CONN_NAME[$sha]}"
            break
        done
    else
        echo "No connected screens detected; cannot create a default layout." >&2
        return 1
    fi
}

# Apply ~/.sclayout left -> right, turning off any screen not listed.
apply_layout(){
    local shas=() sha name
    while read -r sha name; do
        [ -z "$sha" ] && continue
        shas+=("$sha")
    done < "$LAYOUT_FILE"

    for sha in "${shas[@]}"; do
        if [ -z "${CONN_OUTPUT[$sha]}" ]; then
            echo "Screen from layout not connected: $sha"
            return 1
        fi
    done

    local args=() prev="" idx=0 out
    for sha in "${shas[@]}"; do
        out="${CONN_OUTPUT[$sha]}"
        if [ "$idx" -eq 0 ]; then
            args+=(--output "$out" --auto --primary --pos 0x0)
        else
            args+=(--output "$out" --auto --right-of "$prev")
        fi
        prev="$out"
        idx=$((idx + 1))
    done

    # Turn off every connected screen not part of the layout.
    local keep=() offargs
    for sha in "${shas[@]}"; do keep+=("${CONN_OUTPUT[$sha]}"); done
    read -r -a offargs <<< "$(others_off_args "${keep[@]}")"
    args+=("${offargs[@]}")

    log "applying layout: xrandr ${args[*]}"
    echo "Applying layout (left to right): ${shas[*]}"
    xrandr "${args[@]}"
    refresh_wallpaper
    return 0
}

apply_saved_layout(){
    if ! valid_layout; then
        echo "~/.sclayout missing or malformed; recreating default."
        create_default || return 1
    fi
    if ! apply_layout; then
        echo "Saved layout could not be applied (a listed screen is missing)."
        echo "Recreating default layout with the laptop screen only."
        create_default || return 1
        apply_layout
    fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
case "$command" in
    "")   apply_saved_layout ;;
    la)   single_screen "$laptop_sha" "Laptop" ;;
    hd)   single_screen "$hdmi_sha"   "HDMI" ;;
    cp)   mirror_all ;;
    hl)   hdmi_beside_laptop left ;;
    hr)   hdmi_beside_laptop right ;;
    *)    echo "Unknown command: $command"; echo "Run '$0 help' for usage."; exit 1 ;;
esac
