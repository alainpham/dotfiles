#!/bin/sh
#
# Print the best common "mirror" mode across all connected outputs as
# "<WIDTH>x<HEIGHT> <RATE>", or "0" if there is no single mode that every
# connected output supports.
#
# For each connected output it takes that output's highest-"datarate"
# (width * height * refresh) mode, then picks the weakest of those (the
# smallest such datarate) as the candidate, and prints it only if every
# connected output can also display that exact mode.
#
# Pure POSIX sh + awk; no external Python/jc dependency.

xrandr 2>/dev/null | awk '
    function normf(s,   t) {
        # Match the previous Python float formatting: strip trailing zeros
        # but always keep at least one decimal ("60.00" -> "60.0",
        # "59.94" -> "59.94", "50.00" -> "50.0").
        t = s
        sub(/0+$/, "", t)
        if (t ~ /\.$/) t = t "0"
        return t
    }

    # Only consider the first X screen (matches the previous behaviour).
    /^Screen/ { screen++; next }
    screen > 1 { next }

    # Top-level output line, e.g. "HDMI-1 connected primary 1920x1080+0+0 ...".
    /connected/ && $0 !~ /^[ \t]/ {
        dev = $1
        if ($2 == "connected") {
            conn = 1
            if (!(dev in seendev)) { seendev[dev] = 1; order[++ndev] = dev }
        } else {
            conn = 0
        }
        next
    }

    # Indented mode line, e.g. "   1920x1080     60.00*+  59.94".
    conn && /^[ \t]+[0-9]+x[0-9]+/ {
        split($1, res, "x")
        w = res[1] + 0
        h = res[2] + 0
        for (i = 2; i <= NF; i++) {
            f = $i
            gsub(/[*+]/, "", f)
            if (f ~ /^[0-9]+\.[0-9]+$/) {
                dr = w * h * (f + 0)
                have[dev SUBSEP w SUBSEP h SUBSEP f] = 1
                if (dr > maxdr[dev]) {
                    maxdr[dev] = dr
                    mw[dev] = w; mh[dev] = h; mfs[dev] = f
                }
            }
        }
        next
    }

    END {
        if (ndev == 0) { print 0; exit }

        # Candidate = the connected output whose best mode has the smallest
        # datarate (ties resolved by output order, like the original).
        for (i = 1; i <= ndev; i++) {
            d = order[i]
            if (i == 1 || maxdr[d] < mindr) {
                mindr = maxdr[d]
                bw = mw[d]; bh = mh[d]; bfs = mfs[d]
            }
        }

        # Every connected output must support that exact mode.
        for (i = 1; i <= ndev; i++) {
            d = order[i]
            if (!((d SUBSEP bw SUBSEP bh SUBSEP bfs) in have)) { print 0; exit }
        }

        print bw "x" bh " " normf(bfs)
    }
'
