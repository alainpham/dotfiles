#!/bin/bash

# list of distros in the form "name|url"
DISTROS=(
    "opensusetumbleweed|https://download.opensuse.org/tumbleweed/appliances/openSUSE-Tumbleweed-Minimal-VM.x86_64-Cloud.qcow2"
    "ubuntu|https://cloud-images.ubuntu.com/resolute/current/resolute-server-cloudimg-amd64.img"
)

# show choices
echo "Available distros:"
for i in "${!DISTROS[@]}"; do
    name="${DISTROS[$i]%%|*}"
    printf "%d) %s\n" $((i+1)) "$name"
done

# prompt user to choose
read -rp "Choose a distro by number or name: " CHOICE

# resolve choice to entry
SELECTED=""
if [[ "$CHOICE" =~ ^[0-9]+$ ]]; then
    idx=$((CHOICE-1))
    if (( idx>=0 && idx<${#DISTROS[@]} )); then
        SELECTED="${DISTROS[$idx]}"
    fi
else
    for entry in "${DISTROS[@]}"; do
        name="${entry%%|*}"
        if [[ "$CHOICE" == "$name" ]]; then
            SELECTED="$entry"
            break
        fi
    done
fi

if [[ -z "$SELECTED" ]]; then
    echo "Invalid choice." >&2
    exit 1
fi

# export selected distro and URL
export DISTRO_NAME="${SELECTED%%|*}"
export DISTRO_URL="${SELECTED#*|}"

echo "Selected: $DISTRO_NAME -> $DISTRO_URL"

DIR=/home/${USER}/virt/images
VMS_DIR=/home/${USER}/virt/runtime

mkdir -p $DIR
mkdir -p $VMS_DIR

curl -Lo /home/${USER}/virt/images/$DISTRO_NAME.qcow2 $DISTRO_URL

if [ "$DISTRO_NAME" == "opensusetumbleweed" ]; then
    ipaddrsuffix=80
    vmname="twvm"
elif [ "$DISTRO_NAME" == "ubuntu" ]; then
    ipaddrsuffix=90
    vmname="ubvm"
else
    echo "Unknown distro: $DISTRO_NAME" >&2
    exit 1
fi

vmcr $vmname 4096 4 $DISTRO_NAME $ipaddrsuffix 10G linux2024

SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
echo "$(date -R) Bootstrapping dotfiles on $vmname..."
ssh ${SSH_OPTS} $vmname 'curl -L bit.ly/gdot | sh'
echo "$(date -R) Running install on $vmname..."
ssh -t ${SSH_OPTS} $vmname "sudo /home/${USER}/dotfiles/osinstall/install $vmname"

export K3S_WILDCARD_DOMAIN=$(ssh ${SSH_OPTS} $vmname 'bash -lc "echo \$K3S_WILDCARD_DOMAIN"')
export WILDCARD_DOMAIN=$(ssh ${SSH_OPTS} $vmname 'bash -lc "echo \$WILDCARD_DOMAIN"')

# copy only the certs matching the vm's domains (-L resolves the symlinks into archive/)
TLS_LIVE=/home/${USER}/apps/tls/cfg/live
ssh ${SSH_OPTS} $vmname "mkdir -p ${TLS_LIVE} && chmod 700 ${TLS_LIVE}"
for domain in "$WILDCARD_DOMAIN" "$K3S_WILDCARD_DOMAIN"; do
    if [ -n "$domain" ] && [ -d "${TLS_LIVE}/${domain}" ]; then
        echo "$(date -R) Copying cert ${domain} to $vmname..."
        rsync -aL -e "ssh ${SSH_OPTS}" "${TLS_LIVE}/${domain}" $vmname:${TLS_LIVE}/
    else
        echo "$(date -R) No cert found for '${domain}' in ${TLS_LIVE}, skipping."
    fi
done

# make sure ubvm is fully off before copying its disk
if [ "$(virsh domstate ubvm 2>/dev/null)" != "shut off" ]; then
    echo "$(date -R) Shutting down ubvm..."
    virsh shutdown ubvm
    for i in $(seq 1 60); do
        [ "$(virsh domstate ubvm 2>/dev/null)" == "shut off" ] && break
        sleep 2
    done
    if [ "$(virsh domstate ubvm 2>/dev/null)" != "shut off" ]; then
        echo "$(date -R) ubvm did not shut down gracefully, forcing off..."
        virsh destroy ubvm
    fi
fi

cp /home/${USER}/virt/runtime/ubvm.qcow2 /home/${USER}/virt/images/lnsv.qcow2