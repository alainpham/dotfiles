#!/usr/bin/env bash
set -euo pipefail

# Create a GCE VM running the latest openSUSE Leap image.
#
# Usage: ./create-vm.sh [instance-name] [machine-type]
#        defaults: alain-dm, e2-standard-4

INSTANCE_NAME="${1:-alain-dm}"
PROJECT="solutions-engineering-248511"
PROJECT_NUMBER="72723261885"
ZONE="europe-west1-b"
MACHINE_TYPE="${2:-e2-standard-4}"
# small : e2-medium ; bigger : e2-standard-4
IMAGE="projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64"
# IMAGE="projects/opensuse-cloud/global/images/family/opensuse-leap"

# Fail fast if we don't have valid credentials — otherwise every gcloud call
# below dies with a reauth error. Printing an access token forces a token
# refresh and confirms an active account is available.
if ! gcloud auth print-access-token >/dev/null 2>&1; then
    echo "==> No valid gcloud credentials; run 'gcloud auth login' first." >&2
    exit 1
fi

# If a VM with this name already exists in the zone, do nothing (but still
# print its public IP below). Capture stderr so we can tell "already exists"
# and "not found" (proceed to create) apart from a real failure (network,
# permissions) — the latter must NOT be mistaken for "not found" and trigger
# a spurious creation attempt.
if describe_err="$(gcloud compute instances describe "${INSTANCE_NAME}" \
    --project="${PROJECT}" \
    --zone="${ZONE}" 2>&1 >/dev/null)"; then
    echo "Instance '${INSTANCE_NAME}' already exists in ${ZONE}; skipping creation." >&2
elif ! grep -qi "was not found\|does not exist" <<<"${describe_err}"; then
    echo "==> Failed to check instance '${INSTANCE_NAME}' in ${ZONE}:" >&2
    echo "${describe_err}" >&2
    exit 1
else
echo "==> Provisioning instance '${INSTANCE_NAME}' in ${ZONE} (this can take a minute)..." >&2
gcloud compute instances create "${INSTANCE_NAME}" \
    --project="${PROJECT}" \
    --zone="${ZONE}" \
    --verbosity=info \
    --machine-type=${MACHINE_TYPE} \
    --network-interface=network-tier=PREMIUM,stack-type=IPV4_ONLY,subnet=default \
    --metadata=enable-oslogin=true \
    --maintenance-policy=MIGRATE \
    --provisioning-model=STANDARD \
    --create-disk=boot=yes,image-family=${IMAGE},size=30 \
    --no-shielded-secure-boot \
    --shielded-vtpm \
    --shielded-integrity-monitoring \
    --labels=goog-ec-src=vm_add-gcloud \
    --reservation-affinity=any
fi

# Look up the VM's public IP (with progress logging).
echo "==> Describing instance to fetch its public IP..." >&2
PUBLIC_IP="$(gcloud compute instances describe "${INSTANCE_NAME}" \
    --project="${PROJECT}" \
    --zone="${ZONE}" \
    --verbosity=info \
    --format='get(networkInterfaces[0].accessConfigs[0].natIP)')"
echo "==> Public IP: ${PUBLIC_IP}" >&2

# Wait until the VM is RUNNING and its SSH port is actually accepting
# connections before opening the browser SSH session.
echo "==> Waiting for instance to be up and accessible..." >&2
READY=0
for _ in $(seq 1 60); do
    STATUS="$(gcloud compute instances describe "${INSTANCE_NAME}" \
        --project="${PROJECT}" \
        --zone="${ZONE}" \
        --format='get(status)' 2>/dev/null || true)"
    if [[ "${STATUS}" == "RUNNING" ]] \
        && timeout 3 bash -c ">/dev/tcp/${PUBLIC_IP}/22" 2>/dev/null; then
        READY=1
        break
    fi
    echo "    status=${STATUS:-unknown}, ssh not reachable yet; retrying in 5s..." >&2
    sleep 5
done

# Emit the IP on stdout (the script's machine-readable output).
echo "${PUBLIC_IP}"

if [[ "${READY}" -eq 1 ]]; then
    echo "==> Instance is up and SSH is reachable; opening browser SSH." >&2
    SSH_URL="https://ssh.cloud.google.com/v2/ssh/projects/${PROJECT}/zones/${ZONE}/instances/${INSTANCE_NAME}?authuser=1&hl=en_US&projectNumber=${PROJECT_NUMBER}&useAdminProxy=true"
    echo "    ${SSH_URL}" >&2
    xdg-open "${SSH_URL}" >/dev/null 2>&1 &
else
    echo "==> Timed out waiting for the instance to become accessible; not opening browser SSH." >&2
fi
