#!/usr/bin/env bash
set -euo pipefail

# Delete a GCE VM by instance name.
#
# Usage: ./vmgcpdl [instance-name]    (default: alain-dm)

INSTANCE_NAME="${1:-alain-dm}"
PROJECT="solutions-engineering-248511"
ZONE="europe-west1-b"

# Fail fast if we don't have valid credentials — otherwise every gcloud call
# below dies with a reauth error. Printing an access token forces a token
# refresh and confirms an active account is available.
if ! gcloud auth print-access-token >/dev/null 2>&1; then
    echo "==> No valid gcloud credentials; run 'gcloud auth login' first." >&2
    exit 1
fi

# If no VM with this name exists in the zone, there is nothing to do.
# Capture stderr so we can tell "not found" (nothing to delete) apart from a
# real failure (expired auth, network, permissions) — the latter must NOT be
# silently reported as success.
if ! describe_err="$(gcloud compute instances describe "${INSTANCE_NAME}" \
    --project="${PROJECT}" \
    --zone="${ZONE}" 2>&1 >/dev/null)"; then
    if grep -qi "was not found\|does not exist" <<<"${describe_err}"; then
        echo "Instance '${INSTANCE_NAME}' does not exist in ${ZONE}; nothing to delete." >&2
        exit 0
    fi
    echo "==> Failed to check instance '${INSTANCE_NAME}' in ${ZONE}:" >&2
    echo "${describe_err}" >&2
    exit 1
fi

echo "==> Deleting instance '${INSTANCE_NAME}' in ${ZONE} (this can take a minute)..." >&2
gcloud compute instances delete "${INSTANCE_NAME}" \
    --project="${PROJECT}" \
    --zone="${ZONE}" \
    --verbosity=info \
    --quiet

echo "==> Instance '${INSTANCE_NAME}' deleted." >&2
