# start script to detect internal mic/speaker

export internalspeakerid=$(pactl list short sinks | grep -E "alsa_output.pci-" | awk '{print $2}')
export internalmicid=$(pactl list short sources | grep -E "alsa_input.pci-" | awk '{print $2}')

# if multiple dont select hdmi
if [[ "$internalspeakerid" == *$'\n'* ]]; then
    internalspeakerid=$(echo "$internalspeakerid" | grep -v hdmi | head -n1)
fi

# if no mic can be found use dummy
if [ -z "${internalmicid}" ]; then
export internalmicid="alsa_input.dummy-source"
fi

if [[ "$internalmicid" == *$'\n'* ]]; then
    internalmicid=$(echo "$internalmicid" |  head -n1)
fi

export internalspeakervolume="45"
export internalmicvolume="50"

# ensure PRODUCT_NAME is set (fallback to DMI product_name)
if [ -z "${PRODUCT_NAME}" ]; then
    export PRODUCT_NAME=$(cat /sys/devices/virtual/dmi/id/product_name)
fi

# specific to dell g15 5520
if [ "${PRODUCT_NAME}" == "Dell G15 5520" ]; then

    # pulseaudio
    if [ -z "${internalspeakerid}" ]; then
    export internalspeakerid=$(pactl list short sinks | grep -E "alsa_output.pci-0000_00_1f.*Speaker" | awk '{print $2}')
    fi
    if [ -z "${internalmicid}" ]; then
    export internalmicid=$(pactl list short sources | grep -E "alsa_input.pci-0000_00_1f.*Mic" | awk '{print $2}')
    fi    
    # ubuntu & older kernels pulse
    if [ -z "${internalspeakerid}" ]; then
    export internalspeakerid="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__hw_sofhdadsp__sink"
    fi
    if [ -z "${internalmicid}" ]; then
    export internalmicid="alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__hw_sofhdadsp_6__source"
    fi

    export internalspeakervolume="45"
    export internalmicvolume="50"
fi

# specific to lenovo t14 amd
if [ "${PRODUCT_NAME}" == "21MCCTO1WW" ]; then
    # pipewire
    if [ -z "${internalspeakerid}" ]; then
    export internalspeakerid="alsa_output.pci-0000_c4_00.6.HiFi__Speaker__sink"
    fi
    if [ -z "${internalmicid}" ]; then
    export internalmicid="alsa_input.pci-0000_c4_00.6.HiFi__Mic2__source"
    fi
    # pulseaudio
    if [ -z "${internalspeakerid}" ]; then
    export internalspeakerid="alsa_output.pci-0000_c4_00.6.HiFi__hw_Generic_1__sink"
    fi
    if [ -z "${internalmicid}" ]; then
    export internalmicid="alsa_input.pci-0000_c4_00.6.HiFi__hw_acp63__source"
    fi

    export internalspeakervolume="45"
    export internalmicvolume="95"
fi

# end of internal mic/speaker


CARD=$(pactl list short cards | grep alsa_card.usb-Focusrite_Scarlett_2i2_USB | awk '{print $2}')
if [ ! -z "${CARD}" ]; then
    directexists=$(
        pactl -f json list cards | jq -r --arg CARD "$CARD" '
        .[]
        | select(.name == $CARD)
        | .profiles
        | keys[]
        '| grep Direct | wc -l
    )
    if [ "$directexists" == "1" ]; then
        pactl set-card-profile "$CARD" Direct
    fi
fi
export focspeakerid=$(pactl list short sinks | grep -E "alsa_output.usb-Focusrite_Scarlett_2i2.*" | awk '{print $2}')
export focmicid=$(pactl list short sources | grep -E "alsa_input.usb-Focusrite_Scarlett_2i2.*" | awk '{print $2}')
export focspeakervolume="45"
export focmicvolume="100"

export jbrspeakerid=$(pactl list short sinks | grep -E "alsa_output.usb-_Jabra_Link_390_6CFBED605E08-00.*" | awk '{print $2}')
export jbrmicid=$(pactl list short sources | grep -E "alsa_input.usb-_Jabra_Link_390_6CFBED605E08-00.*" | awk '{print $2}')
export jbrspeakervolume="45"
export jbrmicvolume="100"

export hdsspeakerid=$(pactl list short sinks | grep -E "bluez_sink|bluez_output" | awk '{print $2}')
export hdsmicid=$(pactl list short sources | grep -E "bluez_source|bluez_input" | awk '{print $2}')
export hdsspeakervolume="45"
export hdsmicvolume="100"

export bthspeakerid=${hdsspeakerid}
export bthmicid="$internalmicid"
export bthspeakervolume="45"
export bthmicvolume="$internalmicvolume"

export btfspeakerid=${hdsspeakerid}
export btfmicid="$focmicid"
export btfspeakervolume="$bthspeakervolume"
export btfmicvolume="$focmicvolume"

export zvspeakerid=$(pactl list short sinks | grep -E "alsa_output.usb-Logitech_Zone_Vibe_125.*" | awk '{print $2}')
export zvmicid=$(pactl list short sources | grep -E "alsa_input.usb-Logitech_Zone_Vibe_125.*" | awk '{print $2}')
export zvspeakervolume="45"
export zvmicvolume="100"

export h6speakerid=$(pactl list short sinks | grep -E "alsa_output.usb-sky_wing_EKSA_PC_Adapter.*" | awk '{print $2}')
export h6micid=$(pactl list short sources | grep -E "alsa_input.usb-sky_wing_EKSA_PC_Adapter.*" | awk '{print $2}')
export h6speakervolume="45"
export h6micvolume="100"

export acerusbspeakerid=$(pactl list short sinks | grep -E "alsa_output.usb-0c76_USB_Speaker-00.*" | awk '{print $2}')
export acerusbmicid="alsa_input.dummy-source"
export acerusbspeakervolume="45"
export acerusbmicvolume="100"

export dummyspeakerid="alsa_output.dummy-sink"
export dummymicid="alsa_input.dummy-source"
export dummyspeakervolume="45"
export dummymicvolume="100"

declare -A shortsoundnames

if [ -n "${internalspeakerid}" ]; then
    shortsoundnames[${internalspeakerid}]="INT"
fi

if [ -n "${internalmicid}" ]; then
    shortsoundnames[${internalmicid}]="INT"
fi


if [ -n "${focspeakerid}" ]; then
    shortsoundnames[${focspeakerid}]="2I2"
fi

if [ -n "${focmicid}" ]; then
    shortsoundnames[${focmicid}]="2I2"
fi


if [ -n "${jbrspeakerid}" ]; then
    shortsoundnames[${jbrspeakerid}]="JBR"
fi

if [ -n "${jbrmicid}" ]; then
    shortsoundnames[${jbrmicid}]="JBR"
fi


if [ -n "${bthspeakerid}" ]; then
    shortsoundnames[${bthspeakerid}]="BTH"
fi

if [ -n "${bthmicid}" ]; then
    shortsoundnames[${bthmicid}]="INT"
fi


if [ -n "${hdsspeakerid}" ]; then
    shortsoundnames[${hdsspeakerid}]="HDS"
fi

if [ -n "${hdsmicid}" ]; then
    shortsoundnames[${hdsmicid}]="HDS"
fi


if [ -n "${dummyspeakerid}" ]; then
    shortsoundnames[${dummyspeakerid}]="DMY"
fi

if [ -n "${dummymicid}" ]; then
    shortsoundnames[${dummymicid}]="DMY"
fi


if [ -n "${zvspeakerid}" ]; then
    shortsoundnames[${zvspeakerid}]="ZVI"
fi

if [ -n "${zvmicid}" ]; then
    shortsoundnames[${zvmicid}]="ZVI"
fi


if [ -n "${h6speakerid}" ]; then
    shortsoundnames[${h6speakerid}]="H6"
fi

if [ -n "${h6micid}" ]; then
    shortsoundnames[${h6micid}]="H6"
fi


if [ -n "${acerusbspeakerid}" ]; then
    shortsoundnames[${acerusbspeakerid}]="ACR"
fi

if [ -n "${acerusbmicid}" ]; then
    shortsoundnames[${acerusbmicid}]="DMY"
fi
export shortsoundnames