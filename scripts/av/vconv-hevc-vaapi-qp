

#!/bin/bash
extension="${1##*.}"
filename="${1%.*}"
#extreme visually lossess at qp=14
#for normal visual lossless use qp=17 or 18
qp=${2:-20}
ab=${3:-320}
format=${4:-mp4}

ffmpeg -y \
    -vaapi_device /dev/dri/renderD128 \
    -i "$1" \
    -f ${format} \
        -vf 'format=nv12|vaapi,hwupload' \
        -c:v hevc_vaapi \
        -qp ${qp} \
        -c:a libfdk_aac \
        -ab ${ab}k \
        ${filename}-hevc-vaapi-qp${qp}-faac-ab${ab}k.${format}
