#!/bin/sh
echo starting X>~/.xinit.log

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -n "$XDG_RUNTIME_DIR" ] && \
    [ "$XDG_RUNTIME_DIR" = "/run/user/`id -u`" ] && \
    [ -S "$XDG_RUNTIME_DIR/bus" ]; then
  DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  export DBUS_SESSION_BUS_ADDRESS
fi

if [ -x "/usr/bin/dbus-update-activation-environment" ]; then
  dbus-update-activation-environment --verbose --systemd \
    DBUS_SESSION_BUS_ADDRESS \
    DISPLAY \
    XAUTHORITY \
    XDG_CURRENT_DESKTOP \
    ${NULL+}
fi

echo 1 | tee ~/.rebootdwm
export rebootdwm=$(cat ~/.rebootdwm)

while true; do

    # if [ -f ~/.xdpi ]; then 
    #     export XDPI=$(cat ~/.xdpi)
    # else
    #     export XDPI=96
    # fi
    
    # xrandr --dpi $XDPI

    # export WINIT_X11_SCALE_FACTOR=$(awk -v xdpi="$XDPI" 'BEGIN { printf "%.2f\n", xdpi/96 }')
    # export XCURSOR_THEME="Adwaita"
    # export XCURSOR_SIZE=24
    # [ -f ~/.Xresources ] && xrdb -merge ~/.Xresources && echo ".Xresources loaded">>~/.xinit.log

    dwm 2> ~/.dwm.log
    # No error logging
    #dwm >/dev/null 2>&1
    rebootdwm=$(cat ~/.rebootdwm)
    if [ "$rebootdwm" != '1' ]; then
            break
    fi
done