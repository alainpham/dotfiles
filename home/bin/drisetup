# Use the secondary GPU on systems with more than one graphics card.
if command -v lspci >/dev/null 2>&1; then
    gpu_count=$(lspci 2>/dev/null | awk '
        /VGA compatible controller|3D controller|Display controller/ {
            count++
        }
        END { print count + 0 }
    ')

    if [ "$gpu_count" -ge 2 ]; then
        export DRI_PRIME=1
    fi
fi
