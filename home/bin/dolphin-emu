#!/bin/bash

# make all controllers look like a PS3 controller so that it maps generically

SDL_GAMECONTROLLERCONFIG=""

# shanwan wireless with dongle
SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG}0300d859bc2000000055000010010000,PS3 Controller,platform:Linux,a:b0,b:b1,x:b3,y:b4,back:b10,start:b11,guide:b12,leftshoulder:b6,rightshoulder:b7,leftstick:b13,rightstick:b14,leftx:a0,lefty:a1,rightx:a2,righty:a3,lefttrigger:b8,righttrigger:b9,dpup:h0.1,dpleft:h0.8,dpdown:h0.4,dpright:h0.2,"

# XBOX360 wired
SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG}030081b85e0400008e02000014010000,PS3 Controller,platform:Linux,a:b0,b:b1,x:b2,y:b3,back:b6,start:b7,guide:b8,leftshoulder:b4,rightshoulder:b5,leftstick:b9,rightstick:b10,leftx:a0,lefty:a1,rightx:a3,righty:a4,lefttrigger:a2,righttrigger:a5,dpup:h0.1,dpleft:h0.8,dpdown:h0.4,dpright:h0.2,"

# real PS3 through USB
SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG}0300afd34c0500006802000011810000,PS3 Controller,platform:Linux,a:b0,b:b1,x:b3,y:b2,back:b8,start:b9,guide:b10,leftshoulder:b4,rightshoulder:b5,leftstick:b11,rightstick:b12,leftx:a0,lefty:a1,rightx:a3,righty:a4,lefttrigger:a2,righttrigger:a5,dpup:b13,dpleft:b15,dpdown:b14,dpright:b16,"

# real PS3  through bluetooth
SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG}0500f9d24c0500006802000000800000,PS3 Controller,platform:Linux,a:b0,b:b1,x:b3,y:b2,back:b8,start:b9,guide:b10,leftshoulder:b4,rightshoulder:b5,leftstick:b11,rightstick:b12,leftx:a0,lefty:a1,rightx:a3,righty:a4,lefttrigger:a2,righttrigger:a5,dpup:b13,dpleft:b15,dpdown:b14,dpright:b16,"

# shanwan ps3 usb
SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG}0300fc1c4c0500006802000010810000,PS3 Controller,platform:Linux,a:b0,b:b1,x:b3,y:b2,back:b8,start:b9,guide:b10,leftshoulder:b4,rightshoulder:b5,leftstick:b11,rightstick:b12,leftx:a0,lefty:a1,rightx:a3,righty:a4,lefttrigger:a2,righttrigger:a5,dpup:b13,dpleft:b15,dpdown:b14,dpright:b16,"

# fake ps3 usb
SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG}030081b85e0400008e02000010010000,PS3 Controller,platform:Linux,a:b0,b:b1,x:b2,y:b3,back:b6,start:b7,guide:b8,leftshoulder:b4,rightshoulder:b5,leftstick:b9,rightstick:b10,leftx:a0,lefty:a1,rightx:a3,righty:a4,lefttrigger:a2,righttrigger:a5,dpup:h0.1,dpleft:h0.8,dpdown:h0.4,dpright:h0.2,"

# fake datafrog ps4 usb
SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG}0300d0424c050000cc09000011810000,PS3 Controller,platform:Linux,a:b0,b:b1,x:b3,y:b2,back:b8,start:b9,guide:b10,leftshoulder:b4,rightshoulder:b5,leftstick:b11,rightstick:b12,leftx:a0,lefty:a1,rightx:a3,righty:a4,lefttrigger:a2,righttrigger:a5,dpup:h0.1,dpleft:h0.8,dpdown:h0.4,dpright:h0.2,"

# fake datafrog ps4 wireless
SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG}05009b514c050000cc09000000810000,PS3 Controller,platform:Linux,a:b0,b:b1,x:b3,y:b2,back:b8,start:b9,guide:b10,leftshoulder:b4,rightshoulder:b5,leftstick:b11,rightstick:b12,leftx:a0,lefty:a1,rightx:a3,righty:a4,lefttrigger:a2,righttrigger:a5,dpup:h0.1,dpleft:h0.8,dpdown:h0.4,dpright:h0.2,"

export SDL_GAMECONTROLLERCONFIG=$SDL_GAMECONTROLLERCONFIG

CONFIG="$HOME/.config/dolphin-emu/WiimoteNew.ini"
if [ ! -f "$CONFIG" ]; then
    cp $CONFIG.template "$CONFIG"
fi

CONFIG="$HOME/.config/dolphin-emu/GCPadNew.ini"
if [ ! -f "$CONFIG" ]; then
    cp $CONFIG.template "$CONFIG"
fi

CONFIG="$HOME/.config/dolphin-emu/Hotkeys.ini"
if [ ! -f "$CONFIG" ]; then
    cp $CONFIG.template "$CONFIG"
fi

if [ -f /usr/local/bin/dolphin-emu ]; then
    echo launching from /usr/local/bin/dolphin-emu
    /usr/local/bin/dolphin-emu "$@"
fi

if [ -f /usr/local/bin/dolphin-emu ]; then
    echo launching from /run/current-system/sw/bin/dolphin-emu
    /run/current-system/sw/bin/dolphin-emu "$@"
fi

