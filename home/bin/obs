#!/bin/bash
if [ -f /run/current-system/sw/bin/obs ]; then
    export OBSCMD=/run/current-system/sw/bin/obs
elif [ -f /usr/bin/obs ]; then
    export OBSCMD=/usr/bin/obs
elif [ -f /var/lib/flatpak/exports/share/applications/com.obsproject.Studio.desktop ]; then

    if [ -d "$HOME/.var/app/com.obsproject.Studio/config/obs-studio" ]; then
        rm -rf "$HOME/.var/app/com.obsproject.Studio/config/obs-studio"
    fi

    ln -sf "$HOME/.config/obs-studio" \
      "$HOME/.var/app/com.obsproject.Studio/config/obs-studio"
    export OBSCMD="/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=obs com.obsproject.Studio"

else
    echo "obs not found" >&2
    exit 1
fi

mkdir -p $HOME/recordings

link_obs_ports() {
    # Wait up to ~10s for the OBS JACK nodes to register their ports.
    for _ in $(seq 1 50); do
        if pw-link -i 2>/dev/null | grep -q "OBS Studio: 01-03-clr:in_1"; then
            break
        fi
        sleep 0.2
    done

    pw-link "from-desktop" "OBS Studio: 01-02-dtop" 2>/dev/null
    pw-link "from-caller"  "OBS Studio: 01-03-clr"  2>/dev/null
    pw-link "mic01-processed" "OBS Studio: 01-04-mic01" 2>/dev/null
    pw-link "mic02-processed" "OBS Studio: 01-05-mic02" 2>/dev/null
}

if command -v pw-link &> /dev/null ; then
    link_obs_ports &
fi

if command -v pw-jack &> /dev/null ; then
    pw-jack $OBSCMD
else
    $OBSCMD
fi