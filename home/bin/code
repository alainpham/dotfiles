#!/bin/bash

TERMINAL=x-terminal-emulator

if [ -f /run/current-system/sw/bin/code ]; then
    export APPCMD=/run/current-system/sw/bin/code
elif [ -f /usr/bin/code ]; then
    export APPCMD=/usr/bin/code
else
    echo "app not found" >&2
    notify-send "app not found"
    exit 1
fi

export EXTENSION_LIST="
    alphabotsec.vscode-eclipse-keybindings
    anthropic.claude-code
    golang.go
    grafana.grafana-alloy
    jnoortheen.nix-ide
    ms-dotnettools.csharp
    ms-dotnettools.vscode-dotnet-runtime
    ms-python.debugpy
    ms-python.python
    ms-python.vscode-pylance
    ms-python.vscode-python-envs
    ms-vscode-remote.remote-wsl
    ms-vscode.cmake-tools
    ms-vscode.cpp-devtools
    ms-vscode.cpptools
    ms-vscode.cpptools-extension-pack
    ms-vscode.cpptools-themes
    ms-vscode.powershell
    openai.chatgpt
    redhat.java
    redhat.vscode-xml
    redhat.vscode-yaml
    vscjava.vscode-gradle
    vscjava.vscode-java-debug
    vscjava.vscode-java-dependency
    vscjava.vscode-java-pack
    vscjava.vscode-java-test
    vscjava.vscode-maven
    xdebug.php-debug
    xdebug.php-pack
    yzhang.markdown-all-in-one
    zobo.php-intellisense
"

INSTALLED_EXTENSIONS=$($APPCMD --list-extensions)
INSTALL_INSTRUCTIONS=""

for extension in $EXTENSION_LIST; do
    if ! echo "$INSTALLED_EXTENSIONS" | grep -q "$extension"; then
        echo installing $extension
        INSTALL_INSTRUCTIONS="$APPCMD --install-extension $extension ; "$INSTALL_INSTRUCTIONS
    fi
done

if [ -n "$INSTALL_INSTRUCTIONS" ]; then
    echo "installing ..."
    $TERMINAL -e $INSTALL_INSTRUCTIONS
fi

$APPCMD "$@"
