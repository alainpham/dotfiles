#!/bin/bash

if [ -f /usr/local/bin/cemu ]; then
    export APPCMD=/usr/local/bin/cemu
elif [ -f /run/current-system/sw/bin/cemu ]; then
    export APPCMD=/run/current-system/sw/bin/cemu
else
    echo "app not found" >&2
    notify-send "app not found"
    exit 1
fi

lines=$(sdl2-jstest --list | awk '
/Joystick GUID:/  { print $3 }
' | awk '{
  if (!($0 in count)) {
    count[$0] = 0
  } else {
    count[$0]++
  }
  print count[$0] "_" $0
}')

rm ~/.config/Cemu/controllerProfiles/controller*.xml

counter=0
for line in $lines; do
  guid="${line#*_}"
  echo "$counter: $line -> $guid"
  export PAD_UUID=$line
  envsubst < ~/.config/Cemu/controllerProfiles/sdl.xml > ~/.config/Cemu/controllerProfiles/controller${counter}.xml
  ((counter++))
done


$APPCMD "$@"