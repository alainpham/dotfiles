#!/bin/sh

TERMINAL=x-terminal-emulator

if [ -f /run/current-system/sw/bin/estation ]; then
    export APPCMD=gamemode /run/current-system/sw/bin/estation
elif [ -f /usr/local/bin/estation ]; then
    export APPCMD=gamemode /usr/local/bin/estation
else
    echo "app not found" >&2
    notify-send "app not found"
    exit 1
fi


$TERMINAL -e $APPCMD